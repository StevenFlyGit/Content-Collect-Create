{
  // Nebula-React 前端 · 阿里云 ESA Pages 部署配置
  // 使用方式：ESA 控制台 → 边缘计算和 AI → 函数和 Pages → 创建 → 导入 GitHub 仓库
  //   根目录填 /Content-Collect-Create/Nebula-React（monorepo 子目录），ESA 会自动读取本文件
  // API 连接：前端经 .env.production 内置的 VITE_API_BASE 直连函数计算 FC（后端已放行 CORS）
  "name": "nebula-react",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "assets": {
    "directory": "./dist",
    "notFoundStrategy": "singlePageApplication"
  }
}
