# 服务端环境变量示例（复制为 server/.env.local；*.local 已被 Git 忽略，禁止提交真实密钥）
API_PORT=3210

# 本地联调填写 RDS PostgreSQL Serverless 的公网连接地址；部署后优先改用同地域 VPC 内网地址。
# 若用户名或密码含 @、:、/、# 等字符，必须先进行 URL 编码。
DATABASE_URL=postgresql://用户名:密码@RDS公网或内网地址:5432/数据库名
DATABASE_SSL=true
# 本地可先为 false；生产开启证书校验时设为 true，并按需提供 DATABASE_SSL_CA
DATABASE_SSL_REJECT_UNAUTHORIZED=false
DATABASE_SSL_CA=
# Serverless 场景建议从较小连接池开始，避免实例低负载时被过多空闲连接占用。
DB_POOL_MAX=5
DB_IDLE_TIMEOUT_MS=10000
DB_CONNECTION_TIMEOUT_MS=5000

WORKSPACE_ID=00000000-0000-0000-0000-000000000001
# 多个允许来源使用英文逗号分隔，例如 http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGIN=http://localhost:5173
APP_TIMEZONE=Asia/Shanghai

PENDING_ASSET_TTL_MINUTES=30
CLEANUP_INTERVAL_SECONDS=300
PRESIGN_TTL_SECONDS=300

# OSS Bucket 必须为私有，建议与后端/RDS 同地域；AccessKey 只允许存在服务端环境变量中。
OSS_REGION=oss-cn-你的地域
OSS_ENDPOINT=https://oss-cn-你的地域.aliyuncs.com
OSS_BUCKET=你的私有Bucket
OSS_ACCESS_KEY_ID=服务端RAM账号AccessKeyId
OSS_ACCESS_KEY_SECRET=服务端RAM账号AccessKeySecret

# 前端可选环境变量（Nebula-React/.env.local）；不得在 VITE_* 中写入数据库密码或 OSS AccessKey。
# VITE_API_BASE=/api
# VITE_WORKSPACE_ID=00000000-0000-0000-0000-000000000001

# 反向代理与 API 限流；本地保持 TRUST_PROXY=0，部署在可信网关后按实际代理层数设置。
TRUST_PROXY=0
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=300

